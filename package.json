{
  "name": "swobu",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.6",
  "publisher": "swobu",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#050c12",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "language model provider",
    "llm router",
    "model router",
    "provider router",
    "provider switcher",
    "vscode",
    "vscode ai",
    "github copilot",
    "copilot chat",
    "claude code",
    "codex",
    "coding agent",
    "ai gateway",
    "llm gateway",
    "failover",
    "fallback",
    "byok",
    "custom endpoint",
    "openrouter",
    "ollama",
    "lm studio",
    "vllm",
    "llama.cpp",
    "deepseek",
    "openai",
    "anthropic",
    "bedrock",
    "azure openai",
    "local llm",
    "local ai"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "swobu.endpoint",
        "swobu.executable",
        "swobu.modelOverrides"
      ]
    }
  },
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "swobu",
        "displayName": "Swobu"
      }
    ],
    "commands": [
      {
        "command": "swobu.open",
        "title": "%command.0%",
        "category": "Swobu"
      },
      {
        "command": "swobu.setup",
        "title": "%command.1%",
        "category": "Swobu"
      },
      {
        "command": "swobu.connectClaude",
        "title": "%command.2%",
        "category": "Swobu"
      },
      {
        "command": "swobu.connectCodex",
        "title": "%command.3%",
        "category": "Swobu"
      },
      {
        "command": "swobu.configureModel",
        "title": "%command.4%",
        "category": "Swobu"
      },
      {
        "command": "swobu.refreshModels",
        "title": "%command.5%",
        "category": "Swobu"
      }
    ],
    "configuration": {
      "title": "Swobu",
      "properties": {
        "swobu.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:7926",
          "scope": "machine",
          "description": "%configuration.endpoint.description%"
        },
        "swobu.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.executable.description%"
        },
        "swobu.modelOverrides": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "description": "%configuration.modelOverrides.description%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "maxInputTokens": {
                "type": "number",
                "minimum": 1
              },
              "maxOutputTokens": {
                "type": "number",
                "minimum": 1
              },
              "toolCalling": {
                "type": "boolean"
              },
              "imageInput": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:boundaries",
    "verify": "npm run check && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts esbuild.mjs",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "package": "npm run verify && vsce package --no-dependencies",
    "check:vsix": "node scripts/check-vsix.mjs",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "test:e2e:agent": "node scripts/agent-e2e/run.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:check": "node scripts/check-vsix.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "publish:marketplace": "node scripts/publish.mjs marketplace",
    "publish:openvsx": "node scripts/publish.mjs openvsx"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.3-12",
    "esbuild": "0.28.2",
    "eslint": "9.35.0",
    "ovsx": "^0.10.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vscode": "file:test/vscode-stub",
    "yauzl": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/swobuforge/swobu-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/swobuforge/swobu-vscode/issues"
  },
  "homepage": "https://swobu.com",
  "l10n": "./l10n",
  "icon": "assets/icon.png"
}
